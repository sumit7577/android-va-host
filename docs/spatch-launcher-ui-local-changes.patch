diff --git a/app/build.gradle.orig b/app/build.gradle.orig
new file mode 100644
index 0000000..2b4af16
--- /dev/null
+++ b/app/build.gradle.orig
@@ -0,0 +1,66 @@
+apply plugin: 'com.android.application'
+
+android {
+    compileSdk 37
+    defaultConfig {
+        applicationId "net_62v.launcher"
+        minSdkVersion 21
+        targetSdk 37
+        versionCode 1
+        versionName "1.0"
+        android {
+            defaultConfig {
+                ndk {
+                    abiFilters "armeabi-v7a", "x86", "arm64-v8a", "x86_64"
+                }
+            }
+        }
+        splits {
+            abi {
+                enable true
+                reset()
+                include 'x86', 'x86_64', 'armeabi-v7a', "arm64-v8a"
+                universalApk true
+            }
+        }
+    }
+    buildTypes {
+        debug {
+            debuggable false
+            minifyEnabled true
+            shrinkResources true
+            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
+        }
+        release {
+            minifyEnabled true
+            shrinkResources true
+            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
+        }
+    }
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_21
+        targetCompatibility JavaVersion.VERSION_21
+    }
+    packagingOptions {
+        jniLibs {
+            useLegacyPackaging = true
+        }
+    }
+    lint {
+        abortOnError false
+        checkReleaseBuilds false
+    }
+    kotlinOptions {
+        jvmTarget = '21'
+    }
+    namespace 'com.android.launcher'
+    buildFeatures {
+        buildConfig true
+    }
+}
+
+dependencies {
+    implementation fileTree(include: ['*.jar'], dir: 'libs')
+    implementation fileTree(include: ['*.aar'], dir: 'libs')
+    implementation 'com.jakewharton.android.repackaged:dalvik-dx:14.0.0_r21'
+}
diff --git a/app/src/stub/kotlin/net_62v/external/MundoStubs.kt b/app/src/stub/kotlin/net_62v/external/MundoStubs.kt
new file mode 100644
index 0000000..5029ca3
--- /dev/null
+++ b/app/src/stub/kotlin/net_62v/external/MundoStubs.kt
@@ -0,0 +1,75 @@
+/*
+ * FORK-LOCAL SHIMS — not vendor code, not the engine.
+ *
+ * The Mundo SDK (net_62v.external.*) is a closed binary .aar. This file exists
+ * only so the `stub` flavor compiles and installs without it: every member is a
+ * logged no-op. The launcher UI runs; nothing is virtualized.
+ *
+ * Surface below is derived from the four real call sites in this tree:
+ *   LauncherLoader.kt            MetaCore.registerCoreCallback
+ *                                MetaPackageManager.getLaunchIntentForPackage
+ *   Launcher.java:438, 2029      MetaPackageManager.acquireObtainAppSplash
+ *                                MetaActivityManager.obtainSplashLaunchIntent
+ *   Launcher.java:2133-2135      MetaPackageManager.isInnerAppInstalled
+ *                                MetaPackageManager.uninstallAppFully
+ *   LauncherModel.java:2123      MetaPackageManager.acquireObtainAppSplash
+ *   AppsCustomizePagedView:528   MetaActivityManager.obtainSplashLaunchIntent
+ *
+ * When the vendor .aar lands in app/libs, build the `real` flavor instead —
+ * this source set is excluded from it, so there is no duplicate class.
+ */
+package net_62v.external
+
+import android.content.Context
+import android.content.Intent
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+
+private const val TAG = "MetaStub"
+
+object MetaCore {
+    @JvmStatic
+    fun registerCoreCallback(serviceCallback: () -> Unit) {
+        val t0 = SystemClock.elapsedRealtime()
+        Log.w(TAG, "registerCoreCallback: NO ENGINE PRESENT, firing callback synthetically")
+        // Real engine fires this asynchronously once its supervisor binder is up.
+        Handler(Looper.getMainLooper()).post {
+            serviceCallback()
+            Log.i(TAG, "core callback ran after ${SystemClock.elapsedRealtime() - t0}ms (stub)")
+        }
+    }
+}
+
+object MetaPackageManager {
+    @JvmStatic
+    fun getLaunchIntentForPackage(baseIntent: Intent): Intent? {
+        Log.w(TAG, "getLaunchIntentForPackage(${baseIntent.`package`}) -> null (stub)")
+        return null
+    }
+
+    @JvmStatic
+    fun acquireObtainAppSplash() {
+        Log.d(TAG, "acquireObtainAppSplash() no-op (stub)")
+    }
+
+    @JvmStatic
+    fun isInnerAppInstalled(packageName: String): Boolean {
+        Log.d(TAG, "isInnerAppInstalled($packageName) -> false (stub)")
+        return false
+    }
+
+    @JvmStatic
+    fun uninstallAppFully(packageName: String) {
+        Log.w(TAG, "uninstallAppFully($packageName) no-op (stub)")
+    }
+}
+
+object MetaActivityManager {
+    @JvmStatic
+    fun obtainSplashLaunchIntent(partition: Int, packageName: String, context: Context): Intent? {
+        Log.w(TAG, "obtainSplashLaunchIntent(partition=$partition, $packageName) -> null (stub)")
+        return null
+    }
+}
